@if (Mostrar)
{
    <div class="modal-backdrop show"></div>

    <div class="modal fade show" id="exampleModal" tabindex="-1"
         role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true" style="display: block;">

        <div class="modal-dialog" role="document">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">@Titulo</h5>

                    <button @onclick="onCancel" type="button"
                            class="close" data-dismiss="modal"
                            aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    @ChildContent
                </div>

                <div class="modal-footer">

                    @if (verCancelar)
                    {
                        <button @onclick="onCancel" type="button"
                                class="btn btn-secondary"
                                data-dismiss="modal">
                            @textCancelar
                        </button>
                    }

                    @if (verOk)
                    {
                        <button @onclick="onConfirm" type="button"
                                class="btn btn-warning"
                                data-dismiss="modal">
                            @textOk
                        </button>
                    }

                </div>
            </div>
        </div>
    </div>
}

@code {
    // Controla si la ventana de confirmación está visible.
    private bool Mostrar = false;

    // Contenido que se mostrará dentro de la ventana.
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Título y textos de los botones.
    [Parameter] public string Titulo { get; set; } = "Confirmar";
    [Parameter] public string textCancelar { get; set; } = "Cancelar";
    [Parameter] public string textOk { get; set; } = "Aceptar";

    // Acciones que ejecutará el componente padre.
    [Parameter] public EventCallback onCancel { get; set; }
    [Parameter] public EventCallback onConfirm { get; set; }

    // Permite mostrar u ocultar los botones.
    [Parameter] public bool verOk { get; set; } = true;
    [Parameter] public bool verCancelar { get; set; } = true;

    // Abre la ventana de confirmación.
    public void Ver()
    {
        Mostrar = true;
        StateHasChanged();
    }

    // Cierra la ventana de confirmación.
    public void Ocultar()
    {
        Mostrar = false;
        StateHasChanged();
    }
}
